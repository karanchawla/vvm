# critique.vvm
# Critiques an argument by finding its weaknesses.

input argument: "The argument to critique"

agent critic(
  model="sonnet",
  prompt="You find weaknesses in arguments. Be incisive but constructive."
)

critique = @critic `Analyze this argument and identify its weaknesses:

{argument}

Provide 3 counter-points.`(argument)

# Exported names define this module's output contract.
export critique
